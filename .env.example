# ---- IMAP (test mailbox ONLY, never a personal address) ----
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=nc.dev.demo.inbox@gmail.com
IMAP_PASSWORD=xxxx xxxx xxxx xxxx   # Gmail App Password (16 chars)
IMAP_FOLDER=INBOX
IMAP_MARK_SEEN=true

# ---- SMTP (only used by scripts/seed_mailbox.py) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ---- LLM ----
LLM_PROVIDER=anthropic          # anthropic | mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# ---- Notion ----
NOTION_API_KEY=
NOTION_DATABASE_ID=

# ---- Runtime ----
POLL_INTERVAL_SECONDS=60
MAX_EMAILS_PER_RUN=20
DRY_RUN=false
LOG_LEVEL=INFO
